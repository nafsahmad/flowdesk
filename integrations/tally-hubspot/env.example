# Copy this file, name the copy .env, and fill in your own values.
# .env is in .gitignore, so it never gets committed. This example file is safe to commit.

# Your Lambda Function URL (Lambda > Configuration > Function URL)
FUNCTION_URL=https://paste-your-id-here.lambda-url.eu-north-1.on.aws/

# Leave empty until step 8. Then use the same secret you set in Tally and in Lambda.
TALLY_SIGNING_SECRET=
